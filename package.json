{
  "name": "astro-paper-v6",
  "type": "module",
  "version": "6.1.0",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run pagefind:clean && astro check && astro build && pagefind --site dist --root-selector '[data-pagefind-body]' && pnpm run pagefind:sync",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "pagefind:clean": "node scripts/pagefind.mjs clean",
    "pagefind:sync": "node scripts/pagefind.mjs sync",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.33.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "pagefind": "^1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
