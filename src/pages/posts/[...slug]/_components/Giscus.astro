---
import config from "@/config";
---

<section class="mt-12" aria-label="Comments" data-pagefind-ignore>
  <div class="giscus"></div>
  <script
    src="https://giscus.app/client.js"
    data-repo="abowloflrf/blog"
    data-repo-id="MDEwOlJlcG9zaXRvcnkzMzk5MTcwODc="
    data-category="Announcements"
    data-category-id="DIC_kwDOFEK5H84Cd24M"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="noborder_light"
    data-lang={config.site.lang}
    data-loading="lazy"
    crossorigin="anonymous"
    async
    is:inline
    data-astro-rerun></script>
</section>
